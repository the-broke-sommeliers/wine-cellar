#: wine_cellar/apps/wine/forms.py:238
msgid "Enter the name of the wine as indicated on the label."
msgstr "Ange vinets namn som det står på etiketten."

#: wine_cellar/apps/wine/forms.py:243
msgid "Select the type of wine from the dropdown."
msgstr "Välj typ av vin från dropdown-listan"

#: wine_cellar/apps/wine/forms.py:250
msgid "Select the sweetness level of the wine."
msgstr "Ange vinets söthetsgrad"

#: wine_cellar/apps/wine/forms.py:258
msgid "Select the country the wine was produced in as indicated on the label."
msgstr "Ange i vilket land vinet är producerad enligt etiketten."

#: wine_cellar/apps/wine/forms.py:277
msgid ""
"Select the location (region, vineyard, site) the wine is from. Click inside "
"the map to set a marker. The marker can be dragged when pressed."
msgstr ""
"Ange vilken plats vinet är från ( region, vingård,  eller motsvarande ). "
"Klicka i kartan för att placera en kartnål. Kartnålen kan flyttas efter att  "
"den är placerad."

#: wine_cellar/apps/wine/forms.py:288 wine_cellar/apps/wine/models.py:56
#: wine_cellar/apps/wine/templates/wine_detail.html:91
msgid "Size"
msgstr "Storlek"

#: wine_cellar/apps/wine/forms.py:290
msgid "Please enter the volume of bottle or box ect. in liters, e.g. 0.75."
msgstr "Ange flaskans eller boxens volym i liter, tex 0,75"

#: wine_cellar/apps/wine/forms.py:300 wine_cellar/apps/wine/forms.py:513
msgid ""
"Please enter the percentage of alcohol in the wine. This information is "
"typically found on the label and indicates the strength of the wine."
msgstr "Ange vinets alkoholstyrka enligt etiketten."

#: wine_cellar/apps/wine/forms.py:322 wine_cellar/apps/wine/forms.py:502
msgid ""
"Enter the year the grapes were harvested to produce the wine. Typically, "
"vintage years are prominently displayed on wine labels."
msgstr "Ange skördeår för druvorna. Detta anges ofta på etiketten"

#: wine_cellar/apps/wine/forms.py:331
msgid ""
"Select or add the grape varieties used to produce the wine. You can select "
"multiple options if applicable."
msgstr ""
"Välj eller lägg till de druvor som vinet är gjort på. Du kan välja flera om "
"det är aktuellt"

#: wine_cellar/apps/wine/forms.py:340
msgid ""
"Add any attributes that apply to this wine, such as natural, retsina or "
"organic."
msgstr ""
"Lägg till attribut som är aktuella för det här vinet. Tex naturvin, organisk "

#: wine_cellar/apps/wine/forms.py:346 wine_cellar/apps/wine/forms.py:549
msgid "Select the date this wine should be drunk by."
msgstr "Välj datum när vinet senast bör drikcas"

#: wine_cellar/apps/wine/forms.py:355
msgid ""
"Enter dishes, cuisines, or ingredients that complement the flavors of this "
"wine."
msgstr ""
"Ange rätter, kök eller ingredienser som kompletterar smakerna hos det här "
"vinet."

#: wine_cellar/apps/wine/forms.py:364
msgid "Enter the names of the vineyards which produced the wine."
msgstr "Ange namnen på vingårdarna som producerade vinet."

#: wine_cellar/apps/wine/forms.py:370
msgid "Where did you get the wine from?"
msgstr "Var fick du vinet ifrån?"

#: wine_cellar/apps/wine/forms.py:399 wine_cellar/apps/wine/forms.py:563
msgid ""
"Share your thoughts, tasting experiences, or any anecdotes related to this "
"wine."
msgstr ""
"Dela dina tankar, provningsupplevelser eller anekdoter kopplade till det här "
"vinet."

#: wine_cellar/apps/wine/forms.py:406 wine_cellar/apps/wine/forms.py:556
msgid "Rate this wine on a scale from 0 to 10."
msgstr "Betygsätt det här vinet på en skala från 0 till 10."

#: wine_cellar/apps/wine/forms.py:411 wine_cellar/apps/wine/forms.py:570
msgid "Upload a photo of the front of the wine bottle."
msgstr "Ladda upp ett foto av framsidan av vinflaskan."

#: wine_cellar/apps/wine/forms.py:416 wine_cellar/apps/wine/forms.py:575
msgid "Upload a photo of the back of the wine bottle."
msgstr "Ladda upp ett foto av baksidan av vinflaskan."

#: wine_cellar/apps/wine/forms.py:421 wine_cellar/apps/wine/forms.py:580
msgid "Upload a photo of the front of the bottle label."
msgstr "Ladda upp ett foto av framsidan av flaskans etikett."

#: wine_cellar/apps/wine/forms.py:426 wine_cellar/apps/wine/forms.py:585
msgid "Upload a photo of the back of the bottle label."
msgstr "Ladda upp ett foto av baksidan av flaskans etikett."

#: wine_cellar/apps/wine/forms.py:621
msgid "Use these images as the wine's front and back photos"
msgstr "Använd dessa bilder som vinets fram- och baksidesfoton"

#: wine_cellar/apps/wine/forms.py:623
msgid ""
"If checked, the images uploaded above will be attached to the new wine as "
"its front and back photos."
msgstr ""
"Om markerad kommer bilderna som laddats upp ovan att kopplas till det nya "
"vinet som dess fram- och baksidesfoton."

#: wine_cellar/apps/wine/forms.py:634
msgid "At least one image (front or back) must be uploaded."
msgstr "Minst en bild (fram- eller baksida) måste laddas upp."

