#: wine_cellar/apps/wine/tasks.py:229
msgid "AI request failed: invalid API key. Please check your configuration."
msgstr "AI-förfrågan misslyckades: ogiltig API-nyckel. Kontrollera din konfiguration."

#: wine_cellar/apps/wine/tasks.py:239
msgid ""
"AI request failed: rate limit reached. Please wait a moment and try again."
msgstr "AI-förfrågan misslyckades: hastighetsgränsen har nåtts. Vänta en stund och försök igen."

#: wine_cellar/apps/wine/tasks.py:253
msgid ""
"AI service is temporarily unavailable. Please try again in a few minutes."
msgstr "AI-tjänsten är tillfälligt otillgänglig. Försök igen om några minuter."

#: wine_cellar/apps/wine/tasks.py:259
msgid "AI request timed out. Please try again."
msgstr "AI-förfrågan tog för lång tid. Försök igen."

#: wine_cellar/apps/wine/tasks.py:266
msgid ""
"Could not connect to the AI service. Please check your network and "
"configuration."
msgstr "Kunde inte ansluta till AI-tjänsten. Kontrollera ditt nätverk och din konfiguration."

#: wine_cellar/apps/wine/tasks.py:275
msgid "AI request failed. Please try again or check your configuration."
msgstr "AI-förfrågan misslyckades. Försök igen eller kontrollera din konfiguration."

#: wine_cellar/apps/wine/tasks.py:288
msgid ""
"Failed to process AI response. Please check the uploaded images and try "
"again."
msgstr "Kunde inte bearbeta AI-svaret. Kontrollera de uppladdade bilderna och försök igen."

