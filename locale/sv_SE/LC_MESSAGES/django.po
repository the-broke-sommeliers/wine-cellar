msgid "The selected storage has no columns."
msgstr "Den valda lagringsplatsen har inga kolumner"

#: wine_cellar/apps/storage/forms.py:124
msgid "The selected column exceeds the number of columns in the storage."
msgstr ""
"Du har anget en kolumn som överskrider antalet kolumner på lagringsplatsen"

