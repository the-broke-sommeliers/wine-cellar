msgid "Both row and column must be specified for the selected storage."
msgstr "Både rad och kolumn måste anges för den valda lagringsplatsen"

#: wine_cellar/apps/storage/forms.py:154
#, python-format
msgid ""
"The selected slot (row: %(row)s, column: %(column)s) is already occupied in "
"the storage."
msgstr ""
"Den valda platsen ( rad %(row)s, kolumn %(column)s) är upptagen på "
"lagringsplatsen"

