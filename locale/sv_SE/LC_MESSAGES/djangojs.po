#: wine_cellar/assets/js/image_preview.ts:50
msgid "Clear Image"
msgstr "Rensa bild"

#: wine_cellar/assets/js/image_preview.ts:51
msgid "Restore image"
msgstr "Återställ bild"

#: wine_cellar/assets/js/wine_upload_ai.ts:35
msgid "Uploading your photos…"
msgstr "Dina foton laddas upp…"

#: wine_cellar/assets/js/wine_upload_ai.ts:37
msgid "Analyzing your label with AI… this can take up to a minute."
msgstr "Din etikett analyseras med AI… det kan ta upp till en minut."

#: wine_cellar/assets/js/wine_upload_ai.ts:88
msgid "Wine identified — now refining its location…"
msgstr "Vinet är identifierat — förfinar nu dess plats…"

#: wine_cellar/assets/js/wine_upload_ai.ts:89
msgid "Wine identified — now confirming its country of origin…"
msgstr "Vinet är identifierat — bekräftar nu dess ursprungsland…"

#: wine_cellar/assets/js/wine_upload_ai.ts:90
msgid "Wine identified — now confirming its type…"
msgstr "Vinet är identifierat — bekräftar nu dess typ…"

#: wine_cellar/assets/js/wine_upload_ai.ts:91
msgid "Wine identified — now confirming its sweetness…"
msgstr "Vinet är identifierat — bekräftar nu dess sötma…"

#: wine_cellar/assets/js/wine_upload_ai.ts:119
msgid "The AI request failed."
msgstr "AI-förfrågan misslyckades."

#: wine_cellar/assets/js/wine_upload_ai.ts:131
msgid ""
"This is taking longer than expected. Please try again in a few minutes."
msgstr "Det här tar längre tid än väntat. Försök igen om några minuter."

#: wine_cellar/assets/js/wine_upload_ai.ts:168
#: wine_cellar/assets/js/wine_upload_ai.ts:174
msgid "Could not upload the images. Please try again."
msgstr "Kunde inte ladda upp bilderna. Försök igen."

