msgstr "Årgång"

#: wine_cellar/react/react_bar_code.tsx:8
msgid "Advanced"
msgstr "Avancerat"

#: wine_cellar/react/react_bar_code.tsx:10
msgid ""
"Choose the type of barcode you want to scan, sometimes this can help if "
"scanning doesn't work."
msgstr "Välj vilken typ av streckkod du vill skanna, ibland kan det hjälpa om skanningen inte fungerar."

#: wine_cellar/react/react_bar_code.tsx:12
msgid "Scan Barcode"
msgstr "Skanna streckkod"

#: wine_cellar/react/react_bar_code.tsx:13
msgid "Close Scanner"
msgstr "Stäng skannern"

#: wine_cellar/react/react_bar_code.tsx:71
