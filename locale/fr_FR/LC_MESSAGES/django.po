msgstr "Entrer le nombre de rangées dans le stockage."

#: wine_cellar/apps/storage/forms.py:36
msgid "Number of Columns"
msgstr "Nombre de colonnes"

#: wine_cellar/apps/storage/forms.py:37
msgid "Enter the number of columns in the storage."
msgstr "Entrer le nombre de colonnes dans le stockage."

#: wine_cellar/apps/storage/forms.py:43
msgid ""
"Group the storage view by column instead of row, e.g. if you organize by "
"column rather than by shelf."
msgstr ""
"Grouper la vue du stockage par colonne plutôt que par rangée, par exemple si "
"vous organisez par colonne plutôt que par étagère."

#: wine_cellar/apps/storage/forms.py:50
msgid "Show Row Labels"
msgstr "Afficher les étiquettes de rangée"

#: wine_cellar/apps/storage/forms.py:51
msgid "Display and allow naming individual rows (e.g. \"Top Shelf\")."
msgstr ""
"Afficher et permettre de nommer chaque rangée (par exemple \"Étagère du "
"haut\")."

#: wine_cellar/apps/storage/forms.py:56
msgid "Show Column Labels"
msgstr "Afficher les étiquettes de colonne"

#: wine_cellar/apps/storage/forms.py:57
msgid "Display and allow naming individual columns (e.g. \"Left Bin\")."
msgstr ""
"Afficher et permettre de nommer chaque colonne (par exemple \"Casier de "
"gauche\")."

