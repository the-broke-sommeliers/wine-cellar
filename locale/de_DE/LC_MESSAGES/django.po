msgstr "Wie viele Flaschen hinzugefügt werden sollen."

#: wine_cellar/apps/storage/forms.py:102 wine_cellar/apps/storage/forms.py:111
msgid "Invalid slot selection."
msgstr "Ungültige Platzauswahl."

#: wine_cellar/apps/storage/forms.py:135
msgid "Select at least one slot."
msgstr "Wähle mindestens einen Platz aus."

#: wine_cellar/apps/storage/forms.py:140 wine_cellar/apps/storage/views.py:347
msgid "One or more of the selected slots are no longer free. Please reselect."
msgstr ""
"Einer oder mehrere der ausgewählten Plätze sind nicht mehr frei. Bitte wähle "
"erneut aus."

#: wine_cellar/apps/storage/forms.py:155
msgid "Select a slot for this bottle."
msgstr "Wähle einen Platz für diese Flasche aus."

#: wine_cellar/apps/storage/forms.py:163
#, python-format
msgid ""
"The selected slot (row: %(row)s, column: %(column)s) is already occupied in "
"the storage."
msgstr ""
"Der ausgewählte Platz (Reihe: %(row)s, Spalte: %(column)s) ist im Regal "
"bereits belegt."

#: wine_cellar/apps/storage/forms.py:174
msgid "Note"
msgstr "Notiz"

#: wine_cellar/apps/storage/forms.py:177
msgid "Why are you opening this bottle? (e.g. birthday dinner)"
msgstr "Warum öffnest du diese Flasche? (z. B. Geburtstagsessen)"

#: wine_cellar/apps/storage/forms.py:180
msgid "Drink Reminder"
msgstr "Trinkerinnerung"

#: wine_cellar/apps/storage/forms.py:184
msgid "Send a reminder to drink the rest of this bottle by this many days."
msgstr ""
"Sende eine Erinnerung, den Rest dieser Flasche in so vielen Tagen zu trinken."

