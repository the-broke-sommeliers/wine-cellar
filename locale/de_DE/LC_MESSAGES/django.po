#: wine_cellar/apps/storage/forms.py:19
msgid "Storage Description"
msgstr "Regalbeschreibung"

#: wine_cellar/apps/storage/forms.py:20
msgid "Enter a description of the storage."
msgstr "Gib eine Beschreibung des Lagerorts ein."

#: wine_cellar/apps/storage/forms.py:24
#: wine_cellar/apps/storage/templates/storage_detail.html:34
#: wine_cellar/apps/storage/templates/storage_list.html:22
#: wine_cellar/apps/wine/templates/wine_detail.html:290
msgid "Location"
msgstr "Lagerort"

#: wine_cellar/apps/storage/forms.py:25
msgid "Enter the location of the storage."
msgstr "Gib den Lagerort ein."

#: wine_cellar/apps/storage/forms.py:30
msgid "Number of Rows"
msgstr "Anzahl an Reihen"

#: wine_cellar/apps/storage/forms.py:36
msgid "Number of Columns"
msgstr "Anzahl an Spalten"

#: wine_cellar/apps/storage/forms.py:43
msgid ""
"Group the storage view by column instead of row, e.g. if you organize by "
"column rather than by shelf."
msgstr ""
"Gruppiere die Lageransicht nach Spalte statt nach Zeile, z. B. wenn du eher "
"nach Spalte als nach Fach organisierst."

#: wine_cellar/apps/storage/forms.py:50
msgid "Show Row Labels"
msgstr "Zeilenbeschriftungen anzeigen"

#: wine_cellar/apps/storage/forms.py:51
msgid "Display and allow naming individual rows (e.g. \"Top Shelf\")."
msgstr ""
"Zeigt einzelne Zeilen an und erlaubt es, sie zu benennen (z. B. \"Oberes "
"Fach\")."

#: wine_cellar/apps/storage/forms.py:56
msgid "Show Column Labels"
msgstr "Spaltenbeschriftungen anzeigen"

#: wine_cellar/apps/storage/forms.py:57
msgid "Display and allow naming individual columns (e.g. \"Left Bin\")."
msgstr ""
"Zeigt einzelne Spalten an und erlaubt es, sie zu benennen (z. B. \"Linkes "
"Fach\")."

#: wine_cellar/apps/storage/forms.py:74 wine_cellar/apps/wine/forms.py:193
